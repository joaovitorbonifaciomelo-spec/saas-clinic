# Clinic SaaS - Production. Vai para /opt/clinic-saas-production/, ao lado do compose.
#
# HTTPS automatico: com a porta 80 alcancavel e o DNS apontando para a VPS, o Caddy
# obtem e renova o certificado sozinho. Os dados ficam no volume /data.
#
# Proxy so para o frontend. A API nao tem rota aqui: quem fala com ela e o servidor
# do Next, pela rede Docker. O Caddy repassa o Host original e X-Forwarded-Host,
# que o Next compara com o Origin para aceitar Server Actions.
{
	email {$ACME_EMAIL}
	servers {
		# Sem HTTP/3: o compose so publica TCP.
		protocols h1 h2
	}
}

{$PRODUCTION_HOST} {
	encode gzip
	reverse_proxy clinic-saas-production-web:3000
}
