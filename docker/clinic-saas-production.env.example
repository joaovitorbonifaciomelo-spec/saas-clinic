# Modelo de /opt/clinic-saas-production/.env (modo 600, NUNCA versionado).
# Todas sao obrigatorias: sem qualquer uma delas o `docker compose` recusa subir.
#
# Ausentes por construcao: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL e a senha
# do banco. A API usa anon key + JWT do usuario; o RLS e a barreira real.

# IP publico da VPS. O Caddy publica 80 e 443 somente nele.
PUBLIC_IP=

# Hostname publico, sem https://.
PRODUCTION_HOST=

# E-mail da conta ACME, usado pelo Let's Encrypt para avisos do certificado.
ACME_EMAIL=

# Sempre por SHA completo do commit, nunca latest.
WEB_IMAGE=ghcr.io/joaovitorbonifaciomelo-spec/saas-clinic-web:sha-COMMIT
API_IMAGE=ghcr.io/joaovitorbonifaciomelo-spec/saas-clinic-api:sha-COMMIT

# Projeto Supabase PRODUCTION. Nunca o de Development.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origem unica do CORS da API: https:// + PRODUCTION_HOST. Nunca `*`.
WEB_ORIGIN=
